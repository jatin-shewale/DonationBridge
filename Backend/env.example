# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (SQLite by default for local dev; swap to Postgres in prod by setting USE_POSTGRES=True)
USE_POSTGRES=False
DB_NAME=donation_system
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI
AI_CONFIDENCE_THRESHOLD=0.25
AI_BACKEND=stub
# Set GEMINI_API_KEY to enable real vision detection via Gemini flash.
GEMINI_API_KEY=
# Optional: override the model name if you want a different flash variant.
GEMINI_MODEL=gemini-3.6-flash
# AI_BACKEND=yolo   # switch to this once ultralytics is installed and a model path is set
YOLO_MODEL_PATH=yolov8n.pt
